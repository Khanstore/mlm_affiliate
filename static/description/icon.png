<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200">
  <rect width="200" height="200" rx="20" fill="#875A7B"/>
  <!-- people nodes -->
  <circle cx="100" cy="40" r="18" fill="white" opacity="0.95"/>
  <circle cx="50"  cy="110" r="14" fill="white" opacity="0.85"/>
  <circle cx="150" cy="110" r="14" fill="white" opacity="0.85"/>
  <circle cx="25"  cy="170" r="11" fill="white" opacity="0.75"/>
  <circle cx="75"  cy="170" r="11" fill="white" opacity="0.75"/>
  <circle cx="125" cy="170" r="11" fill="white" opacity="0.75"/>
  <circle cx="175" cy="170" r="11" fill="white" opacity="0.75"/>
  <!-- connecting lines -->
  <line x1="100" y1="58"  x2="55"  y2="96"  stroke="white" stroke-width="3" opacity="0.6"/>
  <line x1="100" y1="58"  x2="145" y2="96"  stroke="white" stroke-width="3" opacity="0.6"/>
  <line x1="50"  y1="124" x2="28"  y2="159" stroke="white" stroke-width="2" opacity="0.5"/>
  <line x1="50"  y1="124" x2="72"  y2="159" stroke="white" stroke-width="2" opacity="0.5"/>
  <line x1="150" y1="124" x2="128" y2="159" stroke="white" stroke-width="2" opacity="0.5"/>
  <line x1="150" y1="124" x2="172" y2="159" stroke="white" stroke-width="2" opacity="0.5"/>
</svg>
