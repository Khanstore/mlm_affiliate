<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="affiliate_join_page" name="Affiliate Join Page">
        <t t-call="website.layout">
            <t t-set="head">
                <title>Become an Affiliate Partner</title>
            </t>

            <!-- Check logged-in user's affiliate status once, reuse everywhere -->
            <t t-set="mlm_partner"
               t-value="request.env.user.partner_id.sudo()
                        if not request.env.user._is_public() else None"/>
            <t t-set="already_approved"
               t-value="mlm_partner and mlm_partner.is_affiliate
                        and mlm_partner.affiliate_status == 'approved'"/>
            <t t-set="already_pending"
               t-value="mlm_partner and mlm_partner.is_affiliate
                        and mlm_partner.affiliate_status == 'pending'"/>

            <div class="o_affiliate_join_page">

                <!-- ── Hero ──────────────────────────────────────────────── -->
                <section class="py-5"
                         style="background:linear-gradient(135deg,#1a3c5e 0%,#2e7d32 100%);">
                    <div class="container text-center text-white">
                        <h1 class="display-5 fw-bold mb-3">Become a Referral Partner</h1>
                        <p class="lead mb-0" style="opacity:.8;">
                            Share products you love. Earn commissions on every sale.
                        </p>
                    </div>
                </section>

                <!-- ── Benefits strip ─────────────────────────────────────── -->
                <section class="bg-light py-4 border-bottom">
                    <div class="container">
                        <div class="row text-center g-3">

                            <div class="col-6 col-md-3">
                                <div class="mb-1">
                                    <i class="fa fa-money fa-2x text-success"/>
                                </div>
                                <div class="small fw-semibold">Earn Commissions</div>
                                <div class="text-muted" style="font-size:12px;">
                                    On every referred sale
                                </div>
                            </div>

                            <!-- "Your Own Link" — active link if already approved -->
                            <div class="col-6 col-md-3">
                                <t t-if="already_approved">
                                    <a href="/my/affiliate" class="text-decoration-none text-dark d-block">
                                        <div class="mb-1">
                                            <i class="fa fa-link fa-2x text-primary"/>
                                        </div>
                                        <div class="small fw-semibold text-primary">Your Own Link</div>
                                        <div style="font-size:12px;" class="text-primary">
                                            Go to your dashboard →
                                        </div>
                                    </a>
                                </t>
                                <t t-else="">
                                    <div class="mb-1">
                                        <i class="fa fa-link fa-2x text-secondary"/>
                                    </div>
                                    <div class="small fw-semibold">Your Own Link</div>
                                    <div class="text-muted" style="font-size:12px;">
                                        Share on WhatsApp, Facebook &amp; more
                                    </div>
                                </t>
                            </div>

                            <!-- "Live Dashboard" — active link if already approved -->
                            <div class="col-6 col-md-3">
                                <t t-if="already_approved">
                                    <a href="/my/affiliate" class="text-decoration-none text-dark d-block">
                                        <div class="mb-1">
                                            <i class="fa fa-bar-chart fa-2x text-primary"/>
                                        </div>
                                        <div class="small fw-semibold text-primary">Live Dashboard</div>
                                        <div style="font-size:12px;" class="text-primary">
                                            View earnings →
                                        </div>
                                    </a>
                                </t>
                                <t t-else="">
                                    <div class="mb-1">
                                        <i class="fa fa-bar-chart fa-2x text-secondary"/>
                                    </div>
                                    <div class="small fw-semibold">Live Dashboard</div>
                                    <div class="text-muted" style="font-size:12px;">
                                        Track earnings in real time
                                    </div>
                                </t>
                            </div>

                            <div class="col-6 col-md-3">
                                <div class="mb-1">
                                    <i class="fa fa-gift fa-2x text-warning"/>
                                </div>
                                <div class="small fw-semibold">Free to Join</div>
                                <div class="text-muted" style="font-size:12px;">
                                    No fees, no commitments
                                </div>
                            </div>

                        </div>
                    </div>
                </section>

                <!-- ── Main card ──────────────────────────────────────────── -->
                <section class="py-5">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-12 col-md-7 col-lg-5">
                                <div class="card shadow-sm border-0">
                                    <div class="card-body p-4 p-md-5">

                                        <h4 class="fw-bold mb-1 text-center">Apply Now</h4>
                                        <p class="text-muted text-center small mb-4">
                                            Already a customer? We'll find your account.
                                        </p>

                                        <!-- ── Already approved ── -->
                                        <t t-if="already_approved">
                                            <div class="alert alert-success text-center py-4">
                                                <i class="fa fa-check-circle fa-3x text-success mb-2 d-block"/>
                                                <strong class="d-block mb-2">
                                                    You are already an approved affiliate partner!
                                                </strong>
                                                <div class="d-flex gap-2 justify-content-center flex-wrap mt-3">
                                                    <a href="/my/affiliate"
                                                       class="btn btn-success">
                                                        <i class="fa fa-tachometer me-1"/>
                                                        My Dashboard
                                                    </a>
                                                    <a href="/shop"
                                                       class="btn btn-outline-success">
                                                        <i class="fa fa-shopping-cart me-1"/>
                                                        Shop &amp; Share
                                                    </a>
                                                </div>
                                            </div>
                                        </t>

                                        <!-- ── Pending ── -->
                                        <t t-elif="already_pending">
                                            <div class="alert alert-warning text-center py-4">
                                                <i class="fa fa-clock-o fa-3x text-warning mb-2 d-block"/>
                                                <strong class="d-block mb-1">
                                                    Your application is under review.
                                                </strong>
                                                <p class="mb-0 small text-muted">
                                                    We'll notify you once it's approved.
                                                    Usually within 24 hours.
                                                </p>
                                            </div>
                                        </t>

                                        <!-- ── Application form ── -->
                                        <t t-else="">

                                            <!-- Lookup -->
                                            <div id="o_aff_step_lookup">
                                                <label class="form-label fw-semibold">
                                                    Search by Phone, Mobile or Email
                                                </label>
                                                <div class="input-group mb-2">
                                                    <input id="o_aff_search"
                                                           type="text"
                                                           class="form-control"
                                                           placeholder="01711234567 or email@example.com"
                                                           autocomplete="off"/>
                                                    <button id="o_aff_search_btn"
                                                            class="btn btn-outline-secondary"
                                                            type="button">
                                                        <i class="fa fa-search me-1"/>Search
                                                    </button>
                                                </div>
                                                <div id="o_aff_search_result" class="mb-3"/>
                                                <div class="text-center text-muted small mb-3">
                                                    — or fill in your details below —
                                                </div>
                                            </div>

                                            <!-- Details form -->
                                            <div id="o_aff_form">
                                                <input id="o_aff_partner_id" type="hidden" value=""/>

                                                <!-- Pre-fill if logged in -->
                                                <t t-if="mlm_partner">
                                                    <t t-set="_pname"  t-value="mlm_partner.name or ''"/>
                                                    <t t-set="_pemail" t-value="mlm_partner.email or ''"/>
                                                    <t t-set="_pphone" t-value="mlm_partner.phone or ''"/>
                                                    <t t-set="_pmob"   t-value="mlm_partner.mobile or ''"/>
                                                    <t t-set="_pid"    t-value="str(mlm_partner.id)"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-set="_pname"  t-value="''"/>
                                                    <t t-set="_pemail" t-value="''"/>
                                                    <t t-set="_pphone" t-value="''"/>
                                                    <t t-set="_pmob"   t-value="''"/>
                                                    <t t-set="_pid"    t-value="''"/>
                                                </t>

                                                <t t-if="mlm_partner">
                                                    <script type="text/javascript">
                                                        document.addEventListener('DOMContentLoaded', function() {
                                                            var pidEl = document.getElementById('o_aff_partner_id');
                                                            if (pidEl) pidEl.value = '<t t-esc="_pid"/>';
                                                        });
                                                    </script>
                                                </t>

                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">
                                                        Full Name <span class="text-danger">*</span>
                                                    </label>
                                                    <input id="o_aff_name" type="text"
                                                           class="form-control"
                                                           placeholder="Your full name"
                                                           t-att-value="_pname"
                                                           t-att-readonly="'readonly' if mlm_partner else None"/>
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Email</label>
                                                    <input id="o_aff_email" type="email"
                                                           class="form-control"
                                                           placeholder="your@email.com"
                                                           t-att-value="_pemail"
                                                           t-att-readonly="'readonly' if mlm_partner else None"/>
                                                </div>

                                                <div class="row g-2 mb-3">
                                                    <div class="col-6">
                                                        <label class="form-label fw-semibold">Phone</label>
                                                        <input id="o_aff_phone" type="tel"
                                                               class="form-control"
                                                               placeholder="Land line"
                                                               t-att-value="_pphone"
                                                               t-att-readonly="'readonly' if mlm_partner else None"/>
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label fw-semibold">Mobile</label>
                                                        <input id="o_aff_mobile" type="tel"
                                                               class="form-control"
                                                               placeholder="Mobile number"
                                                               t-att-value="_pmob"
                                                               t-att-readonly="'readonly' if mlm_partner else None"/>
                                                    </div>
                                                </div>

                                                <div id="o_aff_alert" class="d-none mb-3"/>

                                                <button id="o_aff_submit"
                                                        class="btn btn-success w-100 py-2 fw-semibold">
                                                    <i class="fa fa-paper-plane me-1"/>
                                                    Submit Application
                                                </button>

                                                <p class="text-muted text-center mt-3 mb-0"
                                                   style="font-size:12px;">
                                                    Applications are reviewed within 24 hours.
                                                </p>
                                            </div>

                                            <!-- Success state -->
                                            <div id="o_aff_success" class="d-none text-center py-3">
                                                <i class="fa fa-check-circle fa-3x text-success mb-2 d-block"/>
                                                <h5 class="fw-bold">Application Submitted!</h5>
                                                <p class="text-muted" id="o_aff_success_msg"/>
                                                <a href="/shop"
                                                   class="btn btn-outline-success btn-sm mt-1">
                                                    Continue Shopping
                                                </a>
                                            </div>

                                        </t><!-- /t-else form -->
                                    </div>
                                </div>

                                <!-- Not logged in nudge -->
                                <t t-if="request.env.user._is_public()">
                                    <p class="text-center text-muted small mt-3">
                                        Already have an account?
                                        <a t-attf-href="/web/login?redirect=/affiliate/join">Sign in</a>
                                        to apply faster.
                                    </p>
                                </t>

                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

</odoo>
