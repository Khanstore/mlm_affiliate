<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         1. Inject "Affiliate & Earnings" card into /my/home
    ══════════════════════════════════════════════════════════════════ -->

    <template id="portal_my_home_affiliate"
              name="Portal: Affiliate &amp; Earnings"
              inherit_id="portal.portal_my_home"
              customize_show="True"
              priority="50">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Affiliate &amp; Earnings</t>
                <t t-set="url">/my/affiliate</t>
                <t t-set="placeholder_count">affiliate_commission_count</t>
                <t t-set="count" t-value="affiliate_commission_count"/>
                <t t-set="text">Referral link, commissions, wallet and downline.</t>
            </t>
        </xpath>
    </template>

    <!-- ══════════════════════════════════════════════════════════════════
         2. Full affiliate dashboard at /my/affiliate
    ══════════════════════════════════════════════════════════════════ -->

    <template id="portal_affiliate_dashboard" name="Affiliate Dashboard">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" t-value="'affiliate'"/>
            <t t-set="breadcrumbs_searchterm">Affiliate &amp; Earnings</t>

            <div class="container py-4">

                <!-- ── Flash messages ── -->
                <t t-if="request.params.get('payout_submitted')">
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa fa-check-circle me-2"/>
                        <strong>Payout request submitted!</strong> An admin will review it shortly.
                        <button type="button" class="btn-close" data-bs-dismiss="alert"/>
                    </div>
                </t>
                <t t-if="request.params.get('payout_error')">
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa fa-exclamation-circle me-2"/>
                        Invalid payout amount. Please check your available wallet balance.
                        <button type="button" class="btn-close" data-bs-dismiss="alert"/>
                    </div>
                </t>

                <!-- ── Page header ── -->
                <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                    <div>
                        <h3 class="mb-1 fw-bold">
                            <i class="fa fa-users me-2 text-primary"/>Affiliate &amp; Earnings
                        </h3>
                        <p class="text-muted mb-0 small">
                            Welcome, <strong><t t-esc="partner.name"/></strong>
                            <t t-if="partner.upline_partner_id">
                                — referred by <strong><t t-esc="partner.upline_partner_id.name"/></strong>
                            </t>
                            <t t-if="partner.tier_id">
                                <span class="badge bg-warning text-dark ms-2">
                                    <i class="fa fa-star me-1"/>
                                    <t t-esc="partner.tier_id.name"/>
                                </span>
                            </t>
                        </p>
                    </div>
                    <a href="/my/affiliate" class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-refresh me-1"/>Refresh
                    </a>
                </div>

                <!-- ── Active campaign banner ── -->
                <t t-if="active_campaign">
                    <div class="alert alert-info d-flex align-items-center gap-2 mb-4">
                        <i class="fa fa-bolt fa-lg text-warning"/>
                        <div>
                            <strong>Active Campaign: <t t-esc="active_campaign.name"/></strong>
                            — You earn <strong><t t-esc="'%.1f×' % active_campaign.commission_multiplier"/></strong>
                            on every referred sale until
                            <strong><t t-esc="str(active_campaign.date_end)"/></strong>.
                        </div>
                    </div>
                </t>

                <!-- ══ WALLET CARD ══ -->
                <div class="card border-success shadow mb-4">
                    <div class="card-body py-3">
                        <div class="row align-items-center">
                            <div class="col-12 col-md-5 text-center text-md-start mb-3 mb-md-0">
                                <div class="text-muted small text-uppercase fw-semibold mb-1">
                                    Available Wallet Balance
                                </div>
                                <div class="display-5 fw-bold text-success">
                                    <t t-esc="'%.2f' % stats['wallet_balance']"/>
                                </div>
                                <t t-if="stats['wallet_spent'] > 0">
                                    <div class="small text-muted mt-1">
                                        <i class="fa fa-shopping-cart me-1"/>
                                        <t t-esc="'%.2f' % stats['wallet_spent']"/> spent on orders
                                    </div>
                                </t>
                            </div>
                            <div class="col-12 col-md-7">
                                <div class="row g-2 text-center mb-3">
                                    <div class="col-4">
                                        <div class="p-2 rounded border border-warning" style="background:#fff3cd;">
                                            <div class="fw-bold fs-6" style="color:#7d5a00;">
                                                <t t-esc="'%.2f' % (stats.get('pending') or 0.0)"/>
                                            </div>
                                            <small style="color:#856404;">Pending</small>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="p-2 rounded border border-info" style="background:#cff4fc;">
                                            <div class="fw-bold fs-6" style="color:#055160;">
                                                <t t-esc="'%.2f' % (stats.get('approved') or 0.0)"/>
                                            </div>
                                            <small style="color:#055160;">Approved</small>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="p-2 rounded border border-success" style="background:#d1e7dd;">
                                            <div class="fw-bold fs-6" style="color:#0a3622;">
                                                <t t-esc="'%.2f' % (stats.get('paid') or 0.0)"/>
                                            </div>
                                            <small style="color:#0a3622;">Paid Out</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex gap-2 flex-wrap justify-content-center">
                                    <button class="btn btn-success btn-sm" id="applyWalletBtn"
                                            t-att-disabled="'disabled' if stats['wallet_balance'] &lt;= 0 else None">
                                        <i class="fa fa-credit-card me-1"/>Apply to Cart
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm" id="removeWalletBtn">
                                        <i class="fa fa-times me-1"/>Remove from Cart
                                    </button>
                                    <a href="/shop" class="btn btn-outline-success btn-sm">
                                        <i class="fa fa-shopping-cart me-1"/>Shop Now
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Total earned banner -->
                <div class="alert alert-primary d-flex justify-content-between align-items-center mb-4 py-2">
                    <span>
                        <i class="fa fa-trophy me-2"/>
                        <strong>Total Earned (all time):</strong>
                        <span class="ms-1 fs-5 fw-bold">
                            <t t-esc="'%.2f' % stats['total_earned']"/>
                        </span>
                    </span>
                    <span class="badge bg-primary fs-6">
                        <t t-esc="stats['commission_count']"/> commission(s)
                    </span>
                </div>

                <!-- ══ REFERRAL LINK ══ -->
                <div class="card border-primary shadow-sm mb-4">
                    <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between">
                        <span><i class="fa fa-link me-2"/>Your Referral Link</span>
                        <span class="opacity-75 small">
                            <i class="fa fa-mouse-pointer me-1"/>
                            <t t-esc="stats['click_count']"/> clicks
                            <t t-if="stats['last_click']">
                                · last <t t-esc="stats['last_click'].strftime('%d %b')"/>
                            </t>
                        </span>
                    </div>
                    <div class="card-body">
                        <t t-if="referral_url">
                            <div class="row align-items-start">
                                <div class="col-12 col-md-8">
                                    <div class="input-group mb-3">
                                        <input id="mlm_ref_link" type="text"
                                               class="form-control font-monospace small"
                                               t-att-value="referral_url" readonly="readonly"/>
                                        <button class="btn btn-outline-secondary" type="button"
                                                onclick="(function(b){
                                                    var e=document.getElementById('mlm_ref_link');
                                                    e.select();
                                                    navigator.clipboard ? navigator.clipboard.writeText(e.value) : document.execCommand('copy');
                                                    b.innerHTML='&lt;i class=\'fa fa-check\'&gt;&lt;/i&gt; Copied!';
                                                    setTimeout(function(){b.innerHTML='Copy';},2000);
                                                })(this)">Copy</button>
                                    </div>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <a t-attf-href="https://www.facebook.com/sharer/sharer.php?u=#{referral_url}"
                                           target="_blank" rel="noopener" class="btn btn-sm btn-primary">
                                            <i class="fa fa-facebook me-1"/>Facebook
                                        </a>
                                        <a t-attf-href="https://wa.me/?text=#{referral_url}"
                                           target="_blank" rel="noopener" class="btn btn-sm btn-success">
                                            <i class="fa fa-whatsapp me-1"/>WhatsApp
                                        </a>
                                        <a t-attf-href="https://t.me/share/url?url=#{referral_url}"
                                           target="_blank" rel="noopener" class="btn btn-sm btn-info text-white">
                                            <i class="fa fa-telegram me-1"/>Telegram
                                        </a>
                                        <a t-attf-href="mailto:?subject=Check%20this%20out&amp;body=#{referral_url}"
                                           class="btn btn-sm btn-secondary">
                                            <i class="fa fa-envelope me-1"/>Email
                                        </a>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4 text-center mt-3 mt-md-0">
                                    <t t-if="qr_code_b64">
                                        <p class="text-muted small mb-1">Scan to share</p>
                                        <img t-attf-src="data:image/png;base64,#{qr_code_b64}"
                                             alt="Referral QR Code"
                                             style="max-width:130px;border:1px solid #dee2e6;border-radius:6px;padding:4px"/>
                                        <p class="text-muted mt-1" style="font-size:10px">
                                            Right-click → Save image
                                        </p>
                                    </t>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <p class="text-warning mb-0">
                                <i class="fa fa-exclamation-triangle me-1"/>
                                No referral code assigned yet. Please contact support.
                            </p>
                        </t>
                    </div>
                </div>

                <!-- ══ MONTHLY EARNINGS CHART ══ -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header fw-bold">
                        <i class="fa fa-bar-chart me-2"/>Monthly Earnings (Last 12 Months)
                    </div>
                    <div class="card-body">
                        <canvas id="earningsChart" style="max-height:200px;"/>
                    </div>
                </div>

                <!-- ══ MILESTONES ══ -->
                <t t-if="milestones_display">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header fw-bold">
                            <i class="fa fa-trophy me-2 text-warning"/>Milestones
                        </div>
                        <div class="card-body">
                            <div class="row g-2">
                                <t t-foreach="milestones_display" t-as="ms">
                                    <div class="col-12 col-sm-6 col-md-4">
                                        <div t-attf-class="card h-100 border-#{('success' if ms['achieved'] else 'secondary')}">
                                            <div class="card-body p-3">
                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                    <i t-attf-class="fa fa-#{('check-circle text-success' if ms['achieved'] else 'circle-o text-muted')}"/>
                                                    <strong class="small"><t t-esc="ms['name']"/></strong>
                                                </div>
                                                <div class="text-muted" style="font-size:12px">
                                                    Earn ≥ <t t-esc="'%.2f' % ms['min_earned']"/>
                                                    <t t-if="ms['min_referrals']">
                                                        + <t t-esc="ms['min_referrals']"/> referrals
                                                    </t>
                                                    → Bonus <strong><t t-esc="'%.2f' % ms['bonus_amount']"/></strong>
                                                </div>
                                                <t t-if="ms['note']">
                                                    <div class="text-muted mt-1" style="font-size:11px">
                                                        <t t-esc="ms['note']"/>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- ══ PAYOUT REQUEST ══ -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header fw-bold">
                        <i class="fa fa-bank me-2"/>Request a Payout
                    </div>
                    <div class="card-body">
                        <t t-if="stats['wallet_balance'] &lt;= 0">
                            <p class="text-muted mb-0">No approved wallet balance available to withdraw.</p>
                        </t>
                        <t t-else="">
                            <form method="POST" action="/affiliate/payout/request">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label small fw-semibold">Amount</label>
                                        <input type="number" name="amount"
                                               class="form-control form-control-sm"
                                               step="0.01" min="0.01"
                                               t-att-max="stats['wallet_balance']"
                                               t-att-value="'%.2f' % stats['wallet_balance']"/>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-semibold">Payout Method</label>
                                        <select name="payout_method" class="form-select form-select-sm">
                                            <option value="bank">Bank Transfer</option>
                                            <option value="wallet">Keep as Wallet</option>
                                            <option value="discount">Discount Coupon</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-semibold">Bank / Account No.</label>
                                        <input type="text" name="bank_account"
                                               class="form-control form-control-sm"
                                               t-att-value="partner.affiliate_bank_account or ''"
                                               placeholder="IBAN or mobile wallet"/>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-semibold">Note (optional)</label>
                                        <input type="text" name="note"
                                               class="form-control form-control-sm"
                                               placeholder="Any notes for admin…"/>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm mt-3">
                                    <i class="fa fa-paper-plane me-1"/>Submit Request
                                </button>
                            </form>
                        </t>

                        <!-- Recent requests -->
                        <t t-if="payout_requests">
                            <hr/>
                            <div class="small fw-semibold text-muted mb-2">Recent Requests</div>
                            <div class="table-responsive">
                                <table class="table table-sm table-borderless mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Ref</th><th>Date</th>
                                            <th>Method</th><th class="text-end">Amount</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="payout_requests" t-as="pr">
                                            <tr>
                                                <td class="small"><t t-esc="pr.name"/></td>
                                                <td class="small">
                                                    <t t-esc="pr.create_date.strftime('%d %b %Y') if pr.create_date else ''"/>
                                                </td>
                                                <td class="small"><t t-esc="pr.payout_method"/></td>
                                                <td class="text-end small fw-semibold">
                                                    <t t-esc="'%.2f' % pr.amount_requested"/>
                                                </td>
                                                <td>
                                                    <span t-attf-class="badge bg-#{('success' if pr.state == 'paid' else 'info' if pr.state == 'approved' else 'warning' if pr.state == 'draft' else 'danger')} text-#{('dark' if pr.state in ('draft',) else 'white')}">
                                                        <t t-esc="dict(draft='Submitted', approved='Approved', paid='Paid', rejected='Rejected').get(pr.state, pr.state)"/>
                                                    </span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- ══ COMMISSION HISTORY ══ -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header fw-bold d-flex justify-content-between">
                        <span><i class="fa fa-list-alt me-2"/>Earnings History</span>
                        <span class="badge bg-secondary"><t t-esc="len(commissions)"/> shown</span>
                    </div>
                    <div class="card-body p-0">
                        <t t-if="commissions">
                            <div class="table-responsive">
                                <table class="table table-hover table-sm mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Ref</th><th>Date</th><th>Product</th>
                                            <th>Lvl</th><th>Order</th>
                                            <th>Commission</th><th>Method</th><th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="commissions" t-as="com">
                                            <tr>
                                                <td class="text-muted small"><t t-esc="com.name"/></td>
                                                <td class="small">
                                                    <t t-if="com.order_date">
                                                        <t t-esc="com.order_date.strftime('%d %b %Y')"/>
                                                    </t>
                                                </td>
                                                <td class="small">
                                                    <t t-esc="com.product_id.name if com.product_id else ('Milestone Bonus' if com.is_milestone_bonus else '—')"/>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-secondary">
                                                        <t t-if="com.is_milestone_bonus">
                                                            <i class="fa fa-trophy"/>
                                                        </t>
                                                        <t t-else="">
                                                            L<t t-esc="com.level"/>
                                                            <t t-if="com.is_l1_split">
                                                                <i class="fa fa-adjust ms-1" title="Split Commission"/>
                                                            </t>
                                                        </t>
                                                    </span>
                                                </td>
                                                <td class="small">
                                                    <t t-esc="'%.2f' % com.order_amount if com.order_amount else '—'"/>
                                                </td>
                                                <td class="fw-bold text-success">
                                                    <t t-esc="'%.2f' % com.amount"/>
                                                    <t t-if="com.campaign_multiplier and com.campaign_multiplier != 1.0">
                                                        <span class="badge bg-info ms-1" style="font-size:9px">
                                                            <t t-esc="'%.1f×' % com.campaign_multiplier"/>
                                                        </span>
                                                    </t>
                                                    <t t-if="com.level_rate">
                                                        <small class="text-muted">
                                                            (<t t-esc="'%.0f' % com.level_rate"/>%)
                                                        </small>
                                                    </t>
                                                </td>
                                                <td>
                                                    <t t-if="com.payout_method == 'wallet'">
                                                        <span class="badge bg-primary">Wallet</span>
                                                    </t>
                                                    <t t-elif="com.payout_method == 'bank'">
                                                        <span class="badge bg-info text-dark">Bank</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge bg-warning text-dark">
                                                            <t t-if="com.coupon_code">
                                                                <t t-esc="com.coupon_code"/>
                                                            </t>
                                                            <t t-else="">Coupon</t>
                                                        </span>
                                                    </t>
                                                </td>
                                                <td>
                                                    <t t-if="com.state == 'pending'">
                                                        <span class="badge bg-warning text-dark">Pending</span>
                                                    </t>
                                                    <t t-elif="com.state == 'approved'">
                                                        <span class="badge bg-info text-dark">Approved</span>
                                                    </t>
                                                    <t t-elif="com.state == 'paid'">
                                                        <span class="badge bg-success">Paid</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge bg-secondary">Cancelled</span>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                    <tfoot class="table-light fw-bold">
                                        <tr>
                                            <td colspan="5" class="text-end">Total:</td>
                                            <td class="text-success">
                                                <t t-esc="'%.2f' % stats['total_earned']"/>
                                            </td>
                                            <td colspan="2"/>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="text-center py-5 text-muted">
                                <i class="fa fa-inbox fa-3x mb-3 d-block"/>
                                No commissions yet. Share your referral link to start earning!
                            </div>
                        </t>
                    </div>
                </div>

                <!-- ══ LEADERBOARD ══ -->
                <t t-if="leaderboard">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header fw-bold">
                            <i class="fa fa-trophy me-2 text-warning"/>Top Affiliates Leaderboard
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>#</th><th>Affiliate</th><th>Tier</th>
                                            <th class="text-end">Total Earned</th>
                                            <th class="text-center">Referrals</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="leaderboard" t-as="lb">
                                            <tr t-att-class="'table-warning fw-bold' if lb['name'] == partner.name else ''">
                                                <td class="text-muted small">
                                                    <t t-esc="lb_index + 1"/>
                                                </td>
                                                <td>
                                                    <i class="fa fa-user-circle me-1 text-muted"/>
                                                    <t t-esc="lb['name']"/>
                                                    <t t-if="lb['name'] == partner.name">
                                                        <span class="badge bg-success ms-1">You</span>
                                                    </t>
                                                </td>
                                                <td>
                                                    <t t-if="lb.get('tier_id')">
                                                        <span class="badge bg-warning text-dark">
                                                            <t t-esc="lb['tier_id'][1]"/>
                                                        </span>
                                                    </t>
                                                </td>
                                                <td class="text-end fw-bold text-success">
                                                    <t t-esc="'%.2f' % lb['total_commission_earned']"/>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-light text-dark border">
                                                        <t t-esc="lb['downline_count']"/>
                                                    </span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- ══ MY NETWORK ══ -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header fw-bold d-flex justify-content-between">
                        <span><i class="fa fa-sitemap me-2"/>My Network</span>
                        <span class="badge bg-primary">
                            <t t-esc="len(downline)"/> direct referral(s)
                        </span>
                    </div>
                    <div class="card-body p-0">
                        <t t-if="downline">
                            <div class="table-responsive">
                                <table class="table table-sm mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Name</th><th>Tier</th>
                                            <th>Joined</th><th>Their Referrals</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="downline" t-as="member">
                                            <tr>
                                                <td>
                                                    <i class="fa fa-user-circle me-1 text-muted"/>
                                                    <strong><t t-esc="member.name"/></strong>
                                                </td>
                                                <td>
                                                    <t t-if="member.tier_id">
                                                        <span class="badge bg-warning text-dark">
                                                            <t t-esc="member.tier_id.name"/>
                                                        </span>
                                                    </t>
                                                </td>
                                                <td class="small text-muted">
                                                    <t t-if="member.create_date">
                                                        <t t-esc="member.create_date.strftime('%d %b %Y')"/>
                                                    </t>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border">
                                                        <t t-esc="member.downline_count"/>
                                                    </span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="text-center py-4 text-muted">
                                <i class="fa fa-users fa-2x mb-2 d-block"/>
                                No direct referrals yet. Share your link!
                            </div>
                        </t>
                    </div>
                </div>

                <!-- ══ WALLET ORDER HISTORY ══ -->
                <t t-if="wallet_order_history">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header fw-bold">
                            <i class="fa fa-shopping-cart me-2"/>Orders Paid with Wallet
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Order</th><th>Date</th>
                                            <th class="text-end">Order Total</th>
                                            <th class="text-end">Wallet Used</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="wallet_order_history" t-as="wo">
                                            <tr>
                                                <td><t t-esc="wo.name"/></td>
                                                <td class="small">
                                                    <t t-if="wo.date_order">
                                                        <t t-esc="wo.date_order.strftime('%d %b %Y')"/>
                                                    </t>
                                                </td>
                                                <td class="text-end">
                                                    <t t-esc="'%.2f' % wo.amount_total"/>
                                                </td>
                                                <td class="text-end text-success fw-bold">
                                                    − <t t-esc="'%.2f' % wo.wallet_amount_used"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>

            </div><!-- /container -->

            <!-- Chart.js CDN -->
            <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"/>
            <script type="text/javascript">
            (function() {
                // ── Earnings chart ──
                var ctx = document.getElementById('earningsChart');
                if (ctx) {
                    var labels  = <t t-raw="str([d['label']  for d in monthly_data]).replace('&quot;', chr(39))"/>;
                    var amounts = <t t-raw="str([d['amount'] for d in monthly_data])"/>;
                    new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: labels,
                            datasets: [{
                                label: 'Earnings',
                                data: amounts,
                                backgroundColor: 'rgba(13,110,253,0.55)',
                                borderColor: 'rgba(13,110,253,0.9)',
                                borderWidth: 1,
                                borderRadius: 4,
                            }]
                        },
                        options: {
                            responsive: true,
                            plugins: { legend: { display: false } },
                            scales: { y: { beginAtZero: true } }
                        }
                    });
                }

                // ── Wallet apply / remove ──
                function postJson(url, cb) {
                    fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ jsonrpc: '2.0', method: 'call', params: {} })
                    }).then(function(r){ return r.json(); }).then(cb)
                      .catch(function(e){ alert('Request failed: ' + e); });
                }

                var applyBtn = document.getElementById('applyWalletBtn');
                if (applyBtn) {
                    applyBtn.addEventListener('click', function() {
                        postJson('/shop/wallet/apply', function(data) {
                            var res = data.result;
                            if (res &amp;&amp; res.success) {
                                alert('Wallet credit applied: ' + res.wallet_used.toFixed(2) +
                                      (res.fully_covered ? '\nOrder fully covered!' : '\nRemaining: ' + res.remaining.toFixed(2)));
                                location.reload();
                            } else {
                                alert((res &amp;&amp; res.error) || 'Could not apply wallet credit.');
                            }
                        });
                    });
                }

                var removeBtn = document.getElementById('removeWalletBtn');
                if (removeBtn) {
                    removeBtn.addEventListener('click', function() {
                        postJson('/shop/wallet/remove', function() { location.reload(); });
                    });
                }
            })();
            </script>

        </t>
    </template>

</odoo>
