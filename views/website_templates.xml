<odoo>
    <!--
        Inject the affiliate code as a hidden data attribute on every product page.
        affiliate_share.js reads this and rewrites the native Odoo social share
        buttons (Facebook, X, LinkedIn, WhatsApp, Pinterest, Email) so every
        link shared through them already contains the affiliate's /ref/<code>/ URL.

        Nothing visible is added to the page — the native share buttons work
        exactly as before, just with the affiliate link baked in.
    -->
    <template id="product_mlm_affiliate_data"
              inherit_id="website_sale.product"
              name="MLM Affiliate Share Injection">
        <xpath expr="//div[@id='product_details']" position="before">
            <t t-set="mlm_partner" t-value="request.env.user.partner_id.sudo()"/>
            <t t-if="mlm_partner.referral_code">
                <div id="mlm_affiliate_data"
                     class="d-none"
                     t-att-data-ref-code="mlm_partner.referral_code"/>
            </t>
        </xpath>
    </template>
</odoo>
