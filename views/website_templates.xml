<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inject hidden data-ref-code div into the product page.
         JS reads data-ref-code to get the partner's referral code. -->
    <template id="product_mlm_affiliate_data"
              inherit_id="website_sale.product"
              name="MLM Affiliate Data Injection">
        <xpath expr="." position="inside">
            <t t-set="mlm_partner" t-value="request.env.user.partner_id.sudo()"/>
            <t t-if="not request.env.user._is_public() and mlm_partner.referral_code">
                <div id="mlm_affiliate_data"
                     class="d-none"
                     t-att-data-ref-code="mlm_partner.referral_code"/>
            </t>
        </xpath>
    </template>

</odoo>
