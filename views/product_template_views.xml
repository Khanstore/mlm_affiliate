<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         PRODUCT TEMPLATE FORM — Commission Rules tab
         Section A: Template-level rules (by pricelist)
         Section B: Variant-level overrides (by pricelist)
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_product_template_commission_tab" model="ir.ui.view">
        <field name="name">product.template.commission.tab</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Commission Rules" name="mlm_commission_summary">

                    <!-- ── Section A: Template-level rules ─────────────── -->
                    <group string="Product-level Rules  (all variants, per pricelist)">
                        <div class="alert alert-info mb-2" role="alert"
                             invisible="tmpl_commission_ids">
                            <i class="fa fa-info-circle me-1" title="Info"/>
                            No product-level rules. Add rows below — one per
                            pricelist you want to configure. Leave
                            <strong>Pricelist</strong> empty for the public
                            / default rate.
                        </div>
                        <field name="tmpl_commission_ids"
                               nolabel="1"
                               context="{'default_rule_type': 'template',
                                         'default_product_tmpl_id': id}">
                            <list editable="bottom">
                                <field name="rule_type"    column_invisible="1"/>
                                <field name="pricelist_id" string="Pricelist"
                                       optional="show"/>
                                <field name="pricelist_label" string="Scope"
                                       readonly="1"/>
                                <field name="commission_type"/>
                                <field name="commission_value"
                                       string="Total Commission (% or fixed)"/>
                                <field name="active"/>
                            </list>
                        </field>
                    </group>

                    <separator/>

                    <!-- ── Section B: Variant-level overrides ──────────── -->
                    <group string="Variant-level Overrides  (per variant, per pricelist)">
                        <div class="alert alert-secondary mb-2" role="alert">
                            <i class="fa fa-info-circle me-1" title="Info"/>
                            Add rows here to override the product-level rule
                            for a specific variant and/or pricelist.
                        </div>
                        <field name="variant_commission_ids"
                               nolabel="1"
                               context="{'default_rule_type': 'variant',
                                         'default_product_tmpl_id': id}">
                            <list editable="bottom">
                                <field name="rule_type" column_invisible="1"/>
                                <field name="product_id"
                                       string="Variant"
                                       domain="[('product_tmpl_id','=',parent.id)]"
                                       options="{'no_create': True}"/>
                                <field name="pricelist_id" string="Pricelist"
                                       optional="show"/>
                                <field name="pricelist_label" string="Scope"
                                       readonly="1"/>
                                <field name="commission_type"/>
                                <field name="commission_value"
                                       string="Total Commission (% or fixed)"/>
                                <field name="active"/>
                            </list>
                        </field>
                    </group>

                    <div class="alert alert-success mt-3 mb-0" role="alert"
                         invisible="not has_any_commission">
                        <i class="fa fa-check-circle me-1" title="Success"/>
                        <strong>Effective priority for this product:</strong>
                        Variant+PL → Template+PL → Category+PL →
                        Variant → Template → Category → (no commission)
                    </div>

                </page>
            </xpath>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════════════
         SALE ORDER FORM — smart button + Affiliate tab
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_sale_order_referrer" model="ir.ui.view">
        <field name="name">sale.order.referrer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_mlm_commissions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="commission_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="commission_count"/>
                        </span>
                        <span class="o_stat_text">Commissions</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Affiliate Referral"
                      name="mlm_affiliate_referral"
                      invisible="not referrer_partner_id and commission_count == 0">
                    <group string="Referral Info">
                        <field name="referrer_partner_id"/>
                        <field name="referral_code_used"
                               invisible="not referral_code_used"/>
                        <field name="total_commission_amount"
                               string="Total Commissions"
                               invisible="commission_count == 0"/>
                    </group>
                    <group string="Wallet Payment"
                           invisible="wallet_amount_used == 0">
                        <field name="wallet_partner_id"/>
                        <field name="wallet_amount_used"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
