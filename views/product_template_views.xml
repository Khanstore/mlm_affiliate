<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Commission Rule tab on Product form ────────────────────────── -->
    <record id="view_product_template_commission_tab" model="ir.ui.view">
        <field name="name">product.template.commission.tab</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Commission Rule" name="mlm_commission">

                    <!-- Alert when no rule set -->
                    <div class="alert alert-info mb-3" role="alert"
                         invisible="commission_rule_ids">
                        <i class="fa fa-info-circle me-1"/>
                        <strong>No commission rule set for this product.</strong>
                        Add one record below to enable MLM commissions.
                        The total commission will be automatically distributed
                        across levels using the global
                        <strong>Level Distribution Rates</strong>.
                    </div>

                    <!--
                        One record per product (unique constraint).
                        The inline list acts as a simple form-like entry.
                    -->
                    <field name="commission_rule_ids">
                        <list editable="bottom">
                            <field name="commission_type"/>
                            <field name="commission_value"
                                   string="Total Commission (% or fixed amount)"/>
                            <field name="active"/>
                        </list>
                    </field>

                    <!-- Explanation box when rule is present -->
                    <div class="alert alert-success mt-3 mb-0" role="alert"
                         invisible="not commission_rule_ids">
                        <i class="fa fa-check-circle me-1"/>
                        Commission is active. The total pot is split using
                        <strong>MLM Affiliate → Configuration → Level Distribution Rates</strong>.
                        Empty levels are credited to the Admin Account in Settings.
                    </div>

                </page>
            </xpath>
        </field>
    </record>

    <!-- ── Sale Order: smart button + Affiliate tab ───────────────────── -->
    <record id="view_sale_order_referrer" model="ir.ui.view">
        <field name="name">sale.order.referrer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_mlm_commissions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="commission_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="commission_count"/>
                        </span>
                        <span class="o_stat_text">Commissions</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Affiliate Referral"
                      name="mlm_affiliate_referral"
                      invisible="not referrer_partner_id and commission_count == 0">
                    <group string="Referral Info">
                        <field name="referrer_partner_id"/>
                        <field name="referral_code_used"
                               invisible="not referral_code_used"/>
                        <field name="total_commission_amount"
                               string="Total Commissions"
                               invisible="commission_count == 0"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
