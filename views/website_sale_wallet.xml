<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        MLM Wallet Widget — shown on the cart page for logged-in users
        with a positive affiliate wallet balance.

        Odoo 18 COMPATIBILITY NOTE:
        The website_sale.cart template in Odoo 18 is a thin wrapper that
        calls sub-templates (cart_lines, cart_summary, etc.) via t-call.
        Direct element XPaths like #cart_summary, .o_cart_total, or
        //a[@href='/shop/checkout'] do NOT exist at the cart root level.

        Strategy: We do NOT inherit website_sale.cart at all.
        Instead we render the wallet block from the controller by passing
        it as a t-call value, OR we use website_sale.cart_lines which
        is the sub-template that actually contains the cart body.

        We use inherit_id="website_sale.cart" with expr="."
        position="inside" — appending to the root node — which always
        works regardless of internal template structure changes.
    -->
    <template id="cart_wallet_section"
              name="Cart: Wallet Payment Option"
              inherit_id="website_sale.cart">

        <!-- expr="." targets the template root element itself.
             position="inside" appends our block at the end of it.
             This is the only XPath guaranteed to work in any Odoo version
             since the root node always exists. -->
        <xpath expr="." position="inside">
            <t t-if="request.env.user and not request.env.user._is_public()">
                <t t-set="mlm_partner" t-value="request.env.user.partner_id.sudo()"/>
                <t t-set="mlm_wallet"  t-value="mlm_partner.affiliate_wallet_balance"/>

                <t t-if="mlm_wallet and mlm_wallet > 0">
                    <div id="mlm_wallet_section"
                         class="container my-3">
                        <div class="card border-success shadow-sm">
                            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                                <span class="fw-bold">
                                    <i class="fa fa-money me-2" title="Commission"/>MLM Wallet Balance
                                </span>
                                <span class="badge bg-white text-success fs-6">
                                    <t t-esc="'%.2f' % mlm_wallet"/>
                                </span>
                            </div>
                            <div class="card-body py-2">
                                <p class="mb-2 small text-muted">
                                    You have
                                    <strong class="text-success">
                                        <t t-esc="'%.2f' % mlm_wallet"/>
                                    </strong>
                                    in your affiliate wallet.
                                    Apply it to reduce or fully cover this order.
                                </p>
                                <div id="mlm_wallet_controls" class="d-flex gap-2 flex-wrap align-items-center">
                                    <button id="mlm_apply_wallet"
                                            type="button"
                                            class="btn btn-success btn-sm">
                                        <i class="fa fa-check me-1" title="Confirm"/>Apply Wallet Credit
                                    </button>
                                    <button id="mlm_remove_wallet"
                                            type="button"
                                            class="btn btn-outline-secondary btn-sm d-none">
                                        <i class="fa fa-times me-1" title="Remove"/>Remove
                                    </button>
                                    <span id="mlm_wallet_feedback" class="small text-muted ms-2"/>
                                </div>

                                <!-- Full-wallet pay form — shown by JS when wallet covers total -->
                                <form id="mlm_wallet_pay_form"
                                      action="/shop/wallet/pay"
                                      method="POST"
                                      class="mt-2 d-none">
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>
                                    <button type="submit"
                                            class="btn btn-success w-100 fw-bold">
                                        <i class="fa fa-money me-2" title="Commission"/>
                                        Pay Entirely with Wallet — No Card Needed
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </xpath>
    </template>

</odoo>
