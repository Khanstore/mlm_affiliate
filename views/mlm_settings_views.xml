<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_mlm" model="ir.ui.view">
        <field name="name">res.config.settings.mlm.affiliate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="MLM Affiliate" name="mlm_affiliate">
                    <block title="Commission Settings">
                        <setting string="Admin Account (Unallocated Commissions)"
                                 help="Receives commission for any MLM level with no upline partner.">
                            <field name="mlm_admin_partner_id"/>
                        </setting>
                        <!-- FEATURE: minimum payout threshold -->
                        <setting string="Minimum Payout Amount"
                                 help="Commissions below this amount cannot be marked as Paid. Set to 0 to disable.">
                            <field name="mlm_min_payout_threshold"/>
                        </setting>
                    </block>
                    <block title="Email Notifications">
                        <!-- FEATURE: toggle monthly summary emails -->
                        <setting string="Send Monthly Summary Emails"
                                 help="Automatically email every active affiliate a monthly earnings summary.">
                            <field name="mlm_send_monthly_summary"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
