<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Odoo 18: inherit the actual form view (res_config_settings_view_form),
        NOT the action (action_general_configuration).
        Append our <app> block inside the <form> root — safest xpath.
    -->
    <record id="view_res_config_settings_mlm" model="ir.ui.view">
        <field name="name">res.config.settings.mlm.affiliate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="MLM Affiliate" name="mlm_affiliate">
                    <block title="Commission Settings">
                        <setting
                            string="Admin Account (Unallocated Commissions)"
                            help="This partner receives commission portions for any MLM level that has no upline partner in the referral chain.">
                            <field name="mlm_admin_partner_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>