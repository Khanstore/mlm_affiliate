<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List ───────────────────────────────────────────────────────── -->
    <record id="view_mlm_commission_list" model="ir.ui.view">
        <field name="name">mlm.commission.list</field>
        <field name="model">mlm.commission</field>
        <field name="arch" type="xml">
            <list string="Commissions"
                  decoration-info="state == 'pending'"
                  decoration-success="state == 'approved'"
                  decoration-primary="state == 'paid'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="order_date"/>
                <field name="partner_id" string="Earner"/>
                <field name="level"/>
                <field name="level_rate" string="Level Rate (%)"/>
                <field name="total_commission" string="Total Pot" optional="show"/>
                <field name="amount" string="Earned" sum="Total Earned"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="product_id"/>
                <field name="buyer_partner_id" optional="show"/>
                <field name="is_l1_split" string="L1 Split" optional="show"/>
                <field name="split_partner_id" string="Split With" optional="show"/>
                <field name="is_admin_allocation" string="Admin" optional="show"/>
                <field name="payout_method"/>
                <field name="state"
                       widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-info="state == 'approved'"
                       decoration-success="state == 'paid'"
                       decoration-danger="state == 'cancelled'"/>
                <button name="action_approve" type="object"
                        string="Approve" icon="fa-check"
                        class="btn-success btn-sm"
                        invisible="state != 'pending'"/>
                <button name="action_pay" type="object"
                        string="Mark Paid" icon="fa-money"
                        class="btn-primary btn-sm"
                        invisible="state != 'approved'"/>
            </list>
        </field>
    </record>

    <!-- ── Form ───────────────────────────────────────────────────────── -->
    <record id="view_mlm_commission_form" model="ir.ui.view">
        <field name="name">mlm.commission.form</field>
        <field name="model">mlm.commission</field>
        <field name="arch" type="xml">
            <form string="Commission">
                <header>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-success"
                            invisible="state != 'pending'"/>
                    <button name="action_pay" type="object"
                            string="Mark as Paid" class="btn-primary"
                            invisible="state != 'approved'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-danger"
                            invisible="state in ('paid', 'cancelled')"/>
                    <button name="action_reset_to_pending" type="object"
                            string="Reset to Pending"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- L1 Split notice -->
                    <div class="alert alert-info mb-3" role="alert"
                         invisible="not is_l1_split">
                        <i class="fa fa-info-circle me-1" title="Info"/>
                        <strong>Level 1 Split Commission:</strong>
                        The buyer already had an existing upline partner.
                        The Level-1 commission was shared equally (50 / 50) between
                        <strong><field name="partner_id" readonly="1"/></strong>
                        and
                        <strong><field name="split_partner_id" readonly="1"/></strong>.
                    </div>

                    <!-- Admin allocation notice -->
                    <div class="alert alert-warning mb-3" role="alert"
                         invisible="not is_admin_allocation">
                        <i class="fa fa-exclamation-triangle me-1" title="Warning"/>
                        <strong>Admin Allocation:</strong>
                        This commission was redirected to the admin account
                        because Level <field name="level" readonly="1"/>
                        had no upline partner in the referral chain.
                    </div>

                    <group>
                        <group string="Earning Details">
                            <field name="partner_id"/>
                            <field name="level"/>
                            <field name="level_rate" string="Level Rate (%)"/>
                            <field name="total_commission" string="Total Commission Pot"/>
                            <field name="amount" string="Amount Earned"/>
                            <field name="currency_id"/>
                            <field name="is_l1_split"/>
                            <field name="split_partner_id"
                                   invisible="not is_l1_split"/>
                            <field name="is_admin_allocation"/>
                        </group>
                        <group string="Sale Info">
                            <field name="order_id"/>
                            <field name="order_date"/>
                            <field name="product_id"/>
                            <field name="buyer_partner_id"/>
                            <field name="order_amount"/>
                        </group>
                    </group>
                    <group string="Payout">
                        <field name="payout_method"/>
                        <field name="coupon_code"
                               invisible="payout_method != 'discount'"/>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Search ─────────────────────────────────────────────────────── -->
    <record id="view_mlm_commission_search" model="ir.ui.view">
        <field name="name">mlm.commission.search</field>
        <field name="model">mlm.commission</field>
        <field name="arch" type="xml">
            <search string="Commissions">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="order_id"/>
                <field name="product_id"/>
                <separator/>
                <filter name="pending"     string="Pending"          domain="[('state','=','pending')]"/>
                <filter name="approved"    string="Approved"         domain="[('state','=','approved')]"/>
                <filter name="paid"        string="Paid"             domain="[('state','=','paid')]"/>
                <filter name="cancelled"   string="Cancelled"        domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="l1_split"    string="L1 Split"         domain="[('is_l1_split','=',True)]"/>
                <filter name="admin_alloc" string="Admin Alloc."     domain="[('is_admin_allocation','=',True)]"/>
                <filter name="normal"      string="Normal"           domain="[('is_l1_split','=',False),('is_admin_allocation','=',False)]"/>
                <separator/>
                <filter name="wallet"      string="Wallet"           domain="[('payout_method','=','wallet')]"/>
                <filter name="bank"        string="Bank"             domain="[('payout_method','=','bank')]"/>
                <filter name="discount"    string="Discount"         domain="[('payout_method','=','discount')]"/>
                <group expand="0" string="Group By">
                    <filter name="by_earner"  string="Earner"   context="{'group_by':'partner_id'}"/>
                    <filter name="by_level"   string="Level"    context="{'group_by':'level'}"/>
                    <filter name="by_product" string="Product"  context="{'group_by':'product_id'}"/>
                    <filter name="by_state"   string="Status"   context="{'group_by':'state'}"/>
                    <filter name="by_month"   string="Month"    context="{'group_by':'order_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Graph ──────────────────────────────────────────────────────── -->
    <record id="view_mlm_commission_graph" model="ir.ui.view">
        <field name="name">mlm.commission.graph</field>
        <field name="model">mlm.commission</field>
        <field name="arch" type="xml">
            <graph string="Commissions" type="bar">
                <field name="order_date" interval="month"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ── Pivot ──────────────────────────────────────────────────────── -->
    <record id="view_mlm_commission_pivot" model="ir.ui.view">
        <field name="name">mlm.commission.pivot</field>
        <field name="model">mlm.commission</field>
        <field name="arch" type="xml">
            <pivot string="Commissions">
                <field name="partner_id" type="row"/>
                <field name="level"      type="col"/>
                <field name="amount"     type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ── Actions ────────────────────────────────────────────────────── -->
    <record id="action_mlm_commission" model="ir.actions.act_window">
        <field name="name">Commissions</field>
        <field name="res_model">mlm.commission</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_mlm_commission_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No commissions yet!</p>
            <p>Commissions are created automatically when a referred sale order is confirmed.</p>
        </field>
    </record>

    <record id="action_mlm_commission_pending" model="ir.actions.act_window">
        <field name="name">Pending Commissions</field>
        <field name="res_model">mlm.commission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'pending')]</field>
        <field name="search_view_id" ref="view_mlm_commission_search"/>
    </record>

</odoo>
