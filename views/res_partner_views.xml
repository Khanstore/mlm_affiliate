<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        res_partner_views.xml  — patched
        =================================

        CHANGES
        Changes:
        [NEW-1] Smart button: "Referral Network"
            Shows the total count of ALL downline partners across all levels.
            Clicking opens a Kanban view filtered to the partner's full sub-tree
            via action_view_downline_network().

            The existing "Downline" button only showed direct referees and
            incorrectly redirected to the Commissions list.  That button is
            replaced with the new deep-network button.

        [NEW-3] Fraud flag indicator
            A red warning badge appears in the button_box when mlm_fraud_flag
            is True.  Visible only to MLM managers (groups attribute).
            The fraud reason is shown in a collapsible admin section.
    -->

    <record id="view_partner_form_affiliate" model="ir.ui.view">
        <field name="name">res.partner.form.affiliate</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">

                <!-- Commissions earned button (unchanged) -->
                <button name="action_view_mlm_commissions" type="object"
                        class="oe_stat_button" icon="fa-money"
                        invisible="not commission_ids">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="total_commission_earned"/>
                        </span>
                        <span class="o_stat_text">Earned</span>
                    </div>
                </button>

                <!--
                    [NEW-1] Referral Network smart button — replaces the old
                    "Downline" button that only counted direct children and
                    opened the wrong view.
                    Shows total_downline_count (all levels) and opens Kanban.
                -->
                <button name="action_view_downline_network" type="object"
                        class="oe_stat_button" icon="fa-sitemap"
                        invisible="total_downline_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="total_downline_count"/>
                        </span>
                        <span class="o_stat_text">Network</span>
                    </div>
                </button>

                <!-- Direct referral count (kept for quick reference) -->
                <button name="action_view_downline_network" type="object"
                        class="oe_stat_button" icon="fa-users"
                        invisible="downline_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="downline_count"/>
                        </span>
                        <span class="o_stat_text">Direct</span>
                    </div>
                </button>

                <!-- Link click tracker -->
                <button type="object" name="action_view_mlm_commissions"
                        class="oe_stat_button" icon="fa-mouse-pointer"
                        invisible="referral_click_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="referral_click_count"/>
                        </span>
                        <span class="o_stat_text">Link Clicks</span>
                    </div>
                </button>

                <!-- [NEW-3] Fraud flag indicator — only visible to MLM managers -->
                <button type="object" name="action_view_mlm_commissions"
                        class="oe_stat_button btn-danger"
                        icon="fa-exclamation-triangle"
                        invisible="not mlm_fraud_flag"
                        groups="mlm_affiliate.group_mlm_manager">
                    <div class="o_stat_info">
                        <span class="o_stat_text text-white">Fraud<br/>Suspected</span>
                    </div>
                </button>

            </xpath>

            <!-- Affiliate tab — preserve existing content, add fraud section -->
            <xpath expr="//notebook" position="inside">
                <page string="Affiliate / MLM" name="mlm_affiliate">

                    <!-- Application status bar -->
                    <div class="d-flex align-items-center gap-2 mb-3"
                         invisible="not is_affiliate">
                        <span class="fw-semibold text-muted small">Application Status:</span>
                        <field name="affiliate_status" widget="badge"
                               decoration-warning="affiliate_status == 'pending'"
                               decoration-success="affiliate_status == 'approved'"
                               decoration-danger="affiliate_status == 'rejected'"/>
                        <button name="action_approve_affiliate" type="object"
                                string="Approve" class="btn btn-success btn-sm"
                                invisible="affiliate_status == 'approved'"/>
                        <button name="action_reject_affiliate" type="object"
                                string="Reject" class="btn btn-danger btn-sm"
                                invisible="affiliate_status == 'rejected'"/>
                    </div>

                    <group>
                        <group string="Affiliate Settings">
                            <field name="is_affiliate"/>
                            <field name="referral_code"/>
                            <field name="referral_url" widget="url" invisible="not referral_code"/>
                            <button name="action_generate_referral_code" type="object"
                                    string="Generate Referral Code"
                                    class="btn btn-secondary btn-sm"
                                    invisible="referral_code"/>
                            <field name="tier_id"/>
                            <button name="action_update_tier" type="object"
                                    string="Re-evaluate Tier"
                                    class="btn btn-outline-primary btn-sm"
                                    invisible="not is_affiliate"/>
                        </group>
                        <group string="MLM Chain &amp; Wallet">
                            <field name="upline_partner_id"/>
                            <field name="affiliate_wallet_balance"/>
                            <field name="affiliate_bank_account"
                                   placeholder="IBAN / account number / mobile wallet"/>
                        </group>
                    </group>

                    <group string="Referral Link Analytics">
                        <group>
                            <field name="referral_click_count" string="Total Link Clicks"/>
                            <field name="referral_last_click" string="Last Click"/>
                        </group>
                        <group>
                            <field name="downline_count" string="Direct Referrals"/>
                            <field name="total_downline_count" string="Total Network Size"/>
                        </group>
                    </group>

                    <!-- [NEW-3] Fraud section — admin only -->
                    <group string="⚠ Fraud Detection"
                           invisible="not mlm_fraud_flag"
                           groups="mlm_affiliate.group_mlm_manager">
                        <div class="alert alert-danger" role="alert">
                            <strong>This partner has been flagged by the automated fraud detector.</strong>
                            <br/>
                            <field name="mlm_fraud_reason" widget="text" readonly="1"/>
                        </div>
                        <group>
                            <field name="mlm_registration_ip" string="Registration IP" readonly="1"/>
                            <field name="mlm_device_fingerprint" string="Device Fingerprint" readonly="1"/>
                        </group>
                        <div>
                            <button name="action_clear_fraud_flag"
                                    type="object"
                                    string="Clear Fraud Flag"
                                    class="btn btn-warning btn-sm"
                                    confirm="Are you sure you want to clear this fraud flag?"/>
                        </div>
                    </group>

                </page>
            </xpath>

        </field>
    </record>


    <!-- Affiliate list view — referenced by action_affiliate_partners -->
    <record id="view_affiliate_partner_list" model="ir.ui.view">
        <field name="name">res.partner.affiliate.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Affiliates"
                  decoration-warning="affiliate_status == 'pending'"
                  decoration-muted="affiliate_status == 'rejected'">
                <field name="name"/>
                <field name="email"/>
                <field name="referral_code"/>
                <field name="tier_id" string="Tier"/>
                <field name="affiliate_status" widget="badge"
                       decoration-warning="affiliate_status == 'pending'"
                       decoration-success="affiliate_status == 'approved'"
                       decoration-danger="affiliate_status == 'rejected'"/>
                <field name="upline_partner_id"/>
                <field name="downline_count"           string="Direct Referrals"/>
                <field name="referral_click_count"     string="Link Clicks"/>
                <field name="affiliate_wallet_balance" string="Wallet Balance"/>
                <field name="total_commission_earned"  string="Total Earned"/>
                <button name="action_approve_affiliate" type="object"
                        string="Approve" icon="fa-check" class="btn-success btn-sm"
                        invisible="affiliate_status == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="action_affiliate_partners" model="ir.actions.act_window">
        <field name="name">Affiliates</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_affiliate_partner_list"/>
        <field name="domain">[('is_affiliate', '=', True)]</field>
        <field name="context">{'default_is_affiliate': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No affiliates yet!</p>
            <p>Open any contact, go to the <strong>Affiliate / MLM</strong> tab,
               tick <strong>Is Affiliate</strong>, and generate a referral code.</p>
        </field>
    </record>

    <record id="action_affiliate_partners_pending" model="ir.actions.act_window">
        <field name="name">Pending Affiliate Applications</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_affiliate_partner_list"/>
        <field name="domain">[('is_affiliate', '=', True), ('affiliate_status', '=', 'pending')]</field>
    </record>

</odoo>
