<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mlm_level_rate_list" model="ir.ui.view">
        <field name="name">mlm.level.rate.list</field>
        <field name="model">mlm.level.rate</field>
        <field name="arch" type="xml">
            <list string="Level Distribution Rates" editable="bottom"
                  decoration-danger="rate == 0">
                <field name="level"/>
                <field name="description" placeholder="e.g. Direct Referrer"/>
                <field name="rate" string="Rate (%)"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mlm_level_rate_form" model="ir.ui.view">
        <field name="name">mlm.level.rate.form</field>
        <field name="model">mlm.level.rate</field>
        <field name="arch" type="xml">
            <form string="Level Distribution Rate">
                <sheet>
                    <group>
                        <group>
                            <field name="level"/>
                            <field name="description"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="rate" string="Rate (%)"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mlm_level_rate" model="ir.actions.act_window">
        <field name="name">Level Distribution Rates</field>
        <field name="res_model">mlm.level.rate</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No level rates yet!</p>
            <p>
                Add one row per MLM level. Rates define how the product's
                total commission is split across the upline chain.<br/>
                <strong>Example:</strong> L1=80%, L2=10%, L3=6%, L4=4% (total=100%)
            </p>
        </field>
    </record>

</odoo>
