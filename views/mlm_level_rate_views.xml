<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List (editable inline) ─────────────────────────────────────── -->
    <record id="view_mlm_level_rate_list" model="ir.ui.view">
        <field name="name">mlm.level.rate.list</field>
        <field name="model">mlm.level.rate</field>
        <field name="arch" type="xml">
            <list string="Level Distribution Rates"
                  editable="bottom"
                  decoration-danger="rate == 0">
                <field name="level"/>
                <field name="description" placeholder="e.g. Direct Referrer"/>
                <field name="rate"/>
                <field name="active"/>
                <field name="level_label" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ── Form ───────────────────────────────────────────────────────── -->
    <record id="view_mlm_level_rate_form" model="ir.ui.view">
        <field name="name">mlm.level.rate.form</field>
        <field name="model">mlm.level.rate</field>
        <field name="arch" type="xml">
            <form string="Level Distribution Rate">
                <sheet>
                    <group>
                        <group string="Level">
                            <field name="level"/>
                            <field name="description"/>
                            <field name="active"/>
                        </group>
                        <group string="Rate">
                            <field name="rate"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search ─────────────────────────────────────────────────────── -->
    <record id="view_mlm_level_rate_search" model="ir.ui.view">
        <field name="name">mlm.level.rate.search</field>
        <field name="model">mlm.level.rate</field>
        <field name="arch" type="xml">
            <search string="Level Rates">
                <field name="level"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
            </search>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────────────────── -->
    <record id="action_mlm_level_rate" model="ir.actions.act_window">
        <field name="name">Level Distribution Rates</field>
        <field name="res_model">mlm.level.rate</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mlm_level_rate_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No level rates configured yet!
            </p>
            <p>
                Add one row per MLM level. The rates define how the product's
                total commission is split across the upline chain.<br/>
                <strong>Example:</strong>
                Level 1 = 80%, Level 2 = 10%, Level 3 = 6%, Level 4 = 4%
                (total should equal 100%).
            </p>
            <p>
                If a level has no partner in the upline chain, that portion
                goes to the <strong>Admin Account</strong> configured in
                MLM Affiliate → Configuration → Settings.
            </p>
        </field>
    </record>

</odoo>
