<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Commission Approved notification -->
    <record id="email_template_commission_approved" model="mail.template">
        <field name="name">MLM: Commission Approved</field>
        <field name="model_id" ref="mlm_affiliate.model_mlm_commission"/>
        <field name="subject">Your commission of {{ object.amount | round(2) }} has been approved!</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="body_html"><![CDATA[
<p>Hi <strong>{{ object.partner_id.name }}</strong>,</p>
<p>Great news! Your commission has been <strong>approved</strong>.</p>
<table style="border-collapse:collapse;width:100%;max-width:480px">
  <tr><td style="padding:6px 12px;color:#555">Reference</td><td style="padding:6px 12px"><strong>{{ object.name }}</strong></td></tr>
  <tr style="background:#f5f5f5"><td style="padding:6px 12px;color:#555">Amount</td><td style="padding:6px 12px"><strong>{{ object.amount | round(2) }} {{ object.currency_id.name }}</strong></td></tr>
  <tr><td style="padding:6px 12px;color:#555">Payout Method</td><td style="padding:6px 12px">{{ object.payout_method }}</td></tr>
  <tr style="background:#f5f5f5"><td style="padding:6px 12px;color:#555">Order</td><td style="padding:6px 12px">{{ object.order_id.name }}</td></tr>
</table>
<p style="margin-top:16px">
  <a href="/my/affiliate" style="background:#0d6efd;color:#fff;padding:8px 20px;border-radius:4px;text-decoration:none">View Dashboard</a>
</p>
        ]]></field>
        <field name="auto_delete" eval="True"/>
    </record>

    <!-- Commission Paid notification -->
    <record id="email_template_commission_paid" model="mail.template">
        <field name="name">MLM: Commission Paid</field>
        <field name="model_id" ref="mlm_affiliate.model_mlm_commission"/>
        <field name="subject">Your commission of {{ object.amount | round(2) }} has been paid!</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="body_html"><![CDATA[
<p>Hi <strong>{{ object.partner_id.name }}</strong>,</p>
<p>Your commission has been marked as <strong>Paid</strong>.</p>
<table style="border-collapse:collapse;width:100%;max-width:480px">
  <tr><td style="padding:6px 12px;color:#555">Reference</td><td style="padding:6px 12px"><strong>{{ object.name }}</strong></td></tr>
  <tr style="background:#f5f5f5"><td style="padding:6px 12px;color:#555">Amount Paid</td><td style="padding:6px 12px"><strong>{{ object.amount | round(2) }} {{ object.currency_id.name }}</strong></td></tr>
  <tr><td style="padding:6px 12px;color:#555">Payout Method</td><td style="padding:6px 12px">{{ object.payout_method }}</td></tr>
  {% if object.coupon_code %}<tr style="background:#f5f5f5"><td style="padding:6px 12px;color:#555">Coupon Code</td><td style="padding:6px 12px"><strong>{{ object.coupon_code }}</strong></td></tr>{% endif %}
</table>
<p style="margin-top:16px">
  <a href="/my/affiliate" style="background:#198754;color:#fff;padding:8px 20px;border-radius:4px;text-decoration:none">View Dashboard</a>
</p>
        ]]></field>
        <field name="auto_delete" eval="True"/>
    </record>

    <!-- Monthly summary — sent to res.partner -->
    <record id="email_template_monthly_summary" model="mail.template">
        <field name="name">MLM: Monthly Commission Summary</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="subject">Your MLM affiliate summary for {{ context.get('month_name', '') }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="body_html"><![CDATA[
<p>Hi <strong>{{ object.name }}</strong>,</p>
<p>Here is your affiliate earnings summary for <strong>{{ context.get('month_name','last month') }}</strong>:</p>
<table style="border-collapse:collapse;width:100%;max-width:480px">
  <tr><td style="padding:6px 12px;color:#555">Commissions This Month</td><td style="padding:6px 12px"><strong>{{ context.get('commission_count',0) }}</strong></td></tr>
  <tr style="background:#f5f5f5"><td style="padding:6px 12px;color:#555">Total Earned</td><td style="padding:6px 12px"><strong>{{ context.get('month_total',0) | round(2) }}</strong></td></tr>
  <tr><td style="padding:6px 12px;color:#555">Current Wallet Balance</td><td style="padding:6px 12px"><strong>{{ context.get('wallet_balance',0) | round(2) }}</strong></td></tr>
</table>
<p style="margin-top:16px">
  <a href="/my/affiliate" style="background:#0d6efd;color:#fff;padding:8px 20px;border-radius:4px;text-decoration:none">View Full Dashboard</a>
</p>
        ]]></field>
        <field name="auto_delete" eval="True"/>
    </record>

</odoo>
